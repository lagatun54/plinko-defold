[plinko]
slot_count = 10
slot_weights = 0, 0, 0, 5, 65, 30, 0, 0, 0, 0

[bootstrap]
main_collection = /main/main.collectionc
render = /render/default.renderc

[script]
shared_state = 1

[engine]
fixed_update_frequency = 120

[display]
width = 800
height = 600
high_dpi = 1

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01
use_fixed_timestep = 1

[html5]
scale_mode = stretch

[project]
title = test-task-hg-point
dependencies#0 = https://github.com/britzl/monarch/archive/master.zip
dependencies#1 = https://github.com/Insality/defold-event/archive/refs/tags/16.zip
dependencies#2 = https://github.com/Insality/druid/archive/refs/tags/1.3.1.zip
dependencies#3 = https://github.com/Insality/defold-tweener/archive/refs/tags/6.zip

[shader]
exclude_gles_sm100 = 1

