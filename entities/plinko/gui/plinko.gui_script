local plinko_gui = require("entities.plinko.scripts.plinko_gui")

function init(self)
    gui.set_render_order(0)
    msg.post(".", "acquire_input_focus")
    self.plinko = plinko_gui.new(self, { node_prefix = "" })
end

function update(self, dt)
    self.plinko:update(dt)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("configure") then
        self.window_url = message.window_url
        if self.window_url then msg.post(self.window_url, "set_title", { text = "Plinko" }) end
        self.plinko:configure(message.renderer_url)
    end
    self.plinko:on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
    return self.plinko:on_input(action_id, action)
end

function final(self)
    self.plinko:final()
    msg.post(".", "release_input_focus")
end
